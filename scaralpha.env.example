# Backend env for PM2 — copy to scaralpha.env next to this file:
#   cp scaralpha.env.example scaralpha.env
#   nano scaralpha.env
#   ./start-backend-pm2.sh

# Production launch (recommended on VPS):
ASPNETCORE_ENVIRONMENT=Production
BACKEND_PORT=5207
ASPNETCORE_URLS=http://0.0.0.0:5207

# MySQL / Percona on VPS (CyberPanel). Quote the whole connection string.
DATABASE_PROVIDER=MySql
DATABASE_CONNECTION_STRING='Server=127.0.0.1;Port=3306;Database=omar;User=omarr;Password=Ab6432987'

# Required secrets (persistent — never leave empty in Production):
TELEGRAM_BOT_TOKEN=123456:REPLACE_WITH_BOTFATHER_TOKEN
# Telegram Mini App (bot) — must match nginx /app/ and bot_telegram_webapp base /app/
MINIAPP_URL=https://www.scaralphaai.com/app/
JWT_SECRET=REPLACE_WITH_LONG_RANDOM_SECRET_32PLUS
BINOLLA_TOKEN_ENCRYPTION_KEY=REPLACE_WITH_LONG_RANDOM_SECRET_32PLUS
ADMIN_TELEGRAM_USER_IDS=
# Website dashboard admins (comma-separated emails) — required for /dashboard/admin
# ADMIN_EMAILS=scaralphaai@gmail.com

# Frontend origins (comma-separated). Include dashboard origin in production
# (same site origin as Mini App is fine when both are on scaralphaai.com).
# Local: Mini App :5173 + website dashboard :5174
CORS_ORIGINS=https://www.scaralphaai.com,https://scaralphaai.com,https://web.scaralphaai.com,http://localhost:5173,http://127.0.0.1:5173,http://localhost:5174,http://127.0.0.1:5174,http://localhost:5175,http://127.0.0.1:5175,http://localhost:4173,http://127.0.0.1:4173,http://localhost:4174,http://127.0.0.1:4174,http://localhost:4175,http://127.0.0.1:4175

# Optional — Binolla Playwright proxy if VPS IP is geo-blocked:
# Proxy for the Binolla credential-login browser. Set this when Binolla returns HTTP 403
# on /api/auth/login — that means the server's own IP is refused, not a bad password.
# BOTH shapes are accepted (the second is what proxy vendors usually hand you):
#   BINOLLA_AUTH_PROXY=http://user:pass@proxy-host:port
#   BINOLLA_AUTH_PROXY=proxy-host:port:user:pass
#
# Verify it reaches Binolla BEFORE restarting the API:
#   cd backend/tools/binolla-auth && node proxy-check.mjs "<value>"
#
# NOTE: `pm2 restart` alone does NOT reload this file — pm2 keeps the environment it was
# started with. Use `pm2 restart scaralpha-api --update-env` or re-run start-backend-pm2.sh.
# Same proxy for the broker gateway's outbound traffic (Quotex and any future venue).
# Usually the same value as BINOLLA_AUTH_PROXY; set both.
# BROKER_PROXY=

# Broker gateway (backend/brokers). Localhost only — it holds live trading sessions.
# BROKER_GATEWAY_URL=http://127.0.0.1:8100
# BROKER_GATEWAY_TOKEN=

# BINOLLA_AUTH_PROXY=

# Agent/debug NDJSON file logs (debug-*.log) — KEEP OFF in production (eats disk).
# Set to 1 only when debugging Binolla/WS on the VPS.
SCARALPHA_AGENT_DEBUG=0

# Local/dev only (data lost on restart):
# ASPNETCORE_ENVIRONMENT=Development
# DATABASE_PROVIDER=InMemory
