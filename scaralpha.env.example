# Backend env for PM2 — copy to scaralpha.env next to this file:
#   cp scaralpha.env.example scaralpha.env
#   nano scaralpha.env
#   ./start-backend-pm2.sh

ASPNETCORE_ENVIRONMENT=Development
DATABASE_PROVIDER=InMemory
BACKEND_PORT=5207
ASPNETCORE_URLS=http://0.0.0.0:5207

# Required for real Telegram Mini App:
TELEGRAM_BOT_TOKEN=123456:REPLACE_WITH_BOTFATHER_TOKEN
ADMIN_TELEGRAM_USER_IDS=

# Optional (auto-generated if empty, but set them for stable tokens after restart):
# JWT_SECRET=
# BINOLLA_TOKEN_ENCRYPTION_KEY=

# Frontend origin(s) allowed by CORS (comma-separated):
# CORS_ORIGINS=https://www.scaralphaai.com,https://scaralphaai.com

# If VPS IP is geo-blocked by Binolla (e.g. GB), use a proxy in an allowed country:
# BINOLLA_AUTH_PROXY=http://user:pass@proxy-host:port

# Later — Postgres:
# DATABASE_PROVIDER=Npgsql
# DATABASE_CONNECTION_STRING=Host=127.0.0.1;Port=5432;Database=scaralpha;Username=postgres;Password=SECRET
